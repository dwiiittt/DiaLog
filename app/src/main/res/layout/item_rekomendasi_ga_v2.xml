<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp"
    android:layout_margin="4dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivMenuFoto"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/CircleImage"
            android:background="#CBD5E1"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/ivMenuFoto"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvLabelWaktu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WAKTU MAKAN"
                android:textSize="10sp"
                android:textColor="#64748B"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvMenuNama"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nama Resep Akan Muncul"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1E293B"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvMenuNutrisi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 kkal | Karbo 0g | Serat 0g"
                android:textSize="13sp"
                android:textColor="#475569"
                android:layout_marginTop="2dp"/>

        </LinearLayout>
    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>